# WebUI environment example

# n8n webhook for listing submission
N8N_WEBHOOK_URL=http://localhost:5678/webhook/ai-property-analysis

# LLM providers used by assistant / workflow
GROQ_API_KEY=
PERPLEXITY_API_KEY=

# Pinecone knowledge base (optional but recommended)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=property-reports
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=reports

# Embedding model for local semantic retrieval
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_TOP_K=5
