# === Service URLs (Docker Compose internal DNS) ===
RAG_SERVICE_URL=http://rag_service:8001
IMAGE_ANALYSER_URL=http://image_analyser_service:8002
GUARDRAILS_SERVICE_URL=http://guardrails_service:8003
LANGGRAPH_SERVICE_URL=http://langgraph_agent_service:8004

# === RAG Service ===
CHROMA_DIR=./chroma_data
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
GGUF_MODEL_PATH=
TOP_K=3

# === Image Analyser ===
MODEL_CHECKPOINT_PATH=/app/checkpoints/property_room_model.pt
CONFIDENCE_THRESHOLD=0.5
MOCK_INFERENCE=false

# === Guardrails ===
USE_NEMO_GUARDRAILS=false

# === LangGraph Agent ===
HTTP_TIMEOUT=60
HTTP_RETRIES=3

# === WebUI / n8n ===
TRIAGE_API_MODE=n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook/property-triage
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LOG_LEVEL=INFO
